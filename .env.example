# Copy of the settings the cards need. `npm run setup` makes a real .env for you.
# Never paste these into a chat, and never commit .env to GitHub.

# Unlocks your admin page (who's set up a card, hide and reset, the card lists).
ADMIN_KEY=

# Makes the secret code at the end of each card's address (/c/27-k3x9qm).
# ⚠ Once you've written cards, NEVER change this: every card you wrote would stop working.
CARD_SECRET=

# Optional: email card owners a private "edit my card" link, so they can change
# their card later from any phone. Leave blank and only the phone that set a
# card up can edit it.
# RESEND_API_KEY comes from resend.com (free plan is fine).
# EMAIL_FROM must use a domain you've verified in Resend, e.g. Tap Cards <cards@yourdomain.com>
RESEND_API_KEY=
EMAIL_FROM=
